# Copy to .env.local and fill in real values. Never commit .env.local.

# Pollinations (image + video generation gateway) - get one at enter.pollinations.ai
POLLINATIONS_API_KEY=

# Session cookie signing secret - any long random string, generated once locally.
SESSION_SECRET=

# SQLite for local dev. Swapped for a Postgres connection string at deploy time
# (Vercel Storage tab -> Postgres -> auto-filled, no separate account needed).
DATABASE_URL="file:./dev.db"
