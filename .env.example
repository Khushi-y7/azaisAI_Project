# Copy to .env.local and fill in real values. Never commit .env.local.

# Pollinations (image generation) - get one at enter.pollinations.ai
POLLINATIONS_API_KEY=

# Pixazo (free video generation, LTX by Lightricks) - get one at pixazo.ai/api/free
PIXAZO_API_KEY=

# Session cookie signing secret - any long random string, generated once locally.
SESSION_SECRET=

# Postgres connection string. Not a new external service to sign up for:
# on Vercel this comes from the same dashboard you deploy from (Storage tab
# -> Postgres -> Connect, connection string is auto-filled). Use that same
# string for local dev too, so there's one database instead of two setups
# to keep in sync. Run `npx prisma migrate deploy` once against it before
# first use to create the tables.
DATABASE_URL=
