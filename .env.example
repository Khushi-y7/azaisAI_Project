# Copy to .env.local and fill in real values. Never commit .env.local.

# Pollinations (image generation) - get one at enter.pollinations.ai
POLLINATIONS_API_KEY=

# Pixazo (free video generation, LTX by Lightricks) - get one at pixazo.ai/api/free
PIXAZO_API_KEY=

# Session cookie signing secret - any long random string, generated once locally.
SESSION_SECRET=

# SQLite for local dev. Swapped for a Postgres connection string at deploy time
# (Vercel Storage tab -> Postgres -> auto-filled, no separate account needed).
DATABASE_URL="file:./dev.db"
