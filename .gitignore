# Per-session counter/debug state used by the .agent-logs capture hooks.
# Not part of the submission log itself - .agent-logs/ is committed in full.
.claude/state/

# Real secrets - only .env.example (no values) is committed.
.env
.env.local
.env*.local

# Next.js
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts
.DS_Store
*.pem
npm-debug.log*

# Prisma (local SQLite database file)
prisma/dev.db
prisma/dev.db-journal

# User-generated media saved at runtime - not static assets to commit.
public/generated/
